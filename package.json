    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.3",
    "recharts": "^3.10.1",
    "resend": "6.37.x",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
