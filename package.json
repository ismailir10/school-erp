    "prisma": "^7.9.1",
    "react": "19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "resend": "6.18.x",
