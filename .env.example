# Environment Variables
# Copy this file to .env.local and fill in your values

# Bundle Analyzer
# Set to "true" to enable bundle analysis during build
# ANALYZE=true

# Database (Supabase)
# DATABASE_URL="postgresql://..."           # Pooler (port 6543) for app runtime
# DIRECT_URL="postgresql://..."             # Direct (port 5432) — required on Vercel for prisma migrate deploy

# Supabase
# NEXT_PUBLIC_SUPABASE_URL="https://..."
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."           # Server-only — used by scripts/reseed-staging.ts and scripts/finish-xendit.ts

# Payment Gateway selection
# PAYMENT_GATEWAY="xendit"                  # "xendit" | "doku" — unset defaults to "xendit"

# Xendit Payment Gateway
# XENDIT_SECRET_KEY="..."                   # Tier auto-derived from prefix (xnd_development_ vs xnd_production_)
# XENDIT_WEBHOOK_TOKEN="..."

# DOKU Payment Gateway
# DOKU_CLIENT_ID="BRN-xxxx-xxxxxxxxxxxxx"   # From DOKU Back Office → Integration
# DOKU_SECRET_KEY="SK-..."
# DOKU_ENV="sandbox"                        # "sandbox" | "production" — drives the API base URL; DOKU key/Client-Id format does not encode tier the way Xendit's does
# DOKU_NOTIFICATION_TARGET="..."            # Optional operator escape hatch for inbound-notification Request-Target signature verification (see cycle doc A2)

# Resend Email Service
# RESEND_API_KEY="re_..."                   # Omit to simulate email sends in dev
# RESEND_FROM_EMAIL="Talib by An Nisaa' <noreply@annisaasekolahku.com>"
# STAGING_EMAIL_OVERRIDE="admin@example.test"  # Staging-only: redirect all outbound mail to this address

# App Configuration
# NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Per-env; throws if missing on Vercel

# Cron
# CRON_SECRET="..."                         # openssl rand -hex 32; required by /api/cron/* routes

# Parent portal
# SCHOOL_CONTACT_PHONE="0812-3456-7890"     # Optional: public school WhatsApp/phone shown on invoices without a payment link, the pendaftaran payment page and message cards, and the parent portal. Unset -> "hubungi admin sekolah" text only
